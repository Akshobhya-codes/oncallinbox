# ---- Server ----
PORT=3000
# Public HTTPS base URL where Vapi can reach this server's webhook.
# In dev: run `ngrok http 3000` and paste the https URL here (no trailing slash).
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# ---- OpenAI (drafting backbone) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- Vapi (outbound voice calls) ----
VAPI_API_KEY=your-vapi-private-key
# A phone number you provisioned/imported in the Vapi dashboard (used as caller ID).
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
# Voice config (defaults are fine for a demo)
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=burt

# ---- AgentPhone (outbound voice calls — replaces Vapi) ----
# Get the key from agentphone.ai dashboard (format: ap_...).
AGENTPHONE_API_KEY=ap_...
# Filled in by: node scripts/setup-agentphone.js
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_WEBHOOK_SECRET=
AGENTPHONE_VOICE=Polly.Amy

# ---- AgentMail (sending the reply) ----
AGENTMAIL_API_KEY=your-agentmail-api-key
# Optional: default inbox to send from if the trigger payload omits inboxId
AGENTMAIL_DEFAULT_INBOX_ID=

# ---- Who to call (preset, no auth) ----
# The person we phone when an urgent email arrives. E.164 format.
USER_NAME=Akshobhya
USER_PHONE=+14085496556

# ---- Auth (optional) ----
# If set, /api/trigger-call requires header `x-api-key: <this>`.
INTERNAL_API_KEY=
